# Application Settings
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
BASE_URL=http://localhost:8000

# PostgreSQL Settings
# For Docker Compose, the host matches the service name: 'db'
DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/url_shortener

# Redis Settings
# For Docker Compose, the host matches the service name: 'redis'
REDIS_URL=redis://redis:6379/0

# Rate Limiting Settings
RATE_LIMIT_PER_MINUTE=100

RATE_LIMIT_WINDOW_SECONDS=60
# Redirects (GET /{code}) have their own, higher per-client limit
REDIRECT_RATE_LIMIT_PER_MINUTE=600
# Only enable behind a trusted load balancer: the first X-Forwarded-For address becomes the client identity
TRUST_PROXY_HEADERS=false

# Connection pools
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10
REDIS_MAX_CONNECTIONS=200
REDIS_SOCKET_TIMEOUT=0.5

# Click analytics are buffered and written in batches
CLICK_FLUSH_INTERVAL_SECONDS=0.5
CLICK_BATCH_SIZE=1000

LOG_LEVEL=info
